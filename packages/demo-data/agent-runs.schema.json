{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-rm.example/schemas/agent-run-v1.json",
  "title": "Frontier RM Agent Run",
  "type": "object",
  "required": ["schemaVersion", "run", "agents", "events", "outcome"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "run": {
      "type": "object",
      "required": ["id", "clientId", "clientName", "status", "mode", "startedAt", "completedAt", "dataSnapshotAt", "provider"],
      "properties": {
        "id": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "status": { "enum": ["queued", "working", "completed", "revision-requested", "failed"] },
        "mode": { "enum": ["captured-live", "deterministic-rehearsal"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "dataSnapshotAt": { "type": "string", "format": "date-time" },
        "provider": { "type": "string" },
        "traceId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "enum": ["idle", "queued", "working", "completed", "revision-requested", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "timestamp", "type", "agentId", "summary"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "timestamp": { "type": "string", "format": "date-time" },
          "type": { "enum": ["Agent.Plan", "Agent.Delegation", "Agent.ToolCall", "Agent.Evidence", "Agent.Output", "Agent.Status", "Run.Status"] },
          "agentId": { "type": "string" },
          "summary": { "type": "string", "maxLength": 500 },
          "detail": { "type": "string", "maxLength": 2000 },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": ["verificationStatus", "evidenceCount", "meetingBrief", "unresolvedQuestions", "recommendedActions"],
      "properties": {
        "verificationStatus": { "enum": ["verified", "revision-requested", "failed"] },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "meetingBrief": { "type": "string" },
        "unresolvedQuestions": { "type": "array", "items": { "type": "string" } },
        "recommendedActions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
